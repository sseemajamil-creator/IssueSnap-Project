git add .# IssueSnap Environment Configuration
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Engine: use 'sqlite3' for quick local dev (no setup needed),
# or 'mysql' for production (requires MySQL server running).
DB_ENGINE=sqlite3

# MySQL settings (used only when DB_ENGINE=mysql)
DB_NAME=issuesnap_db
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=3306

# Email (SMTP) - optional. Default uses console backend (prints to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# AI Model
AI_CONFIDENCE_THRESHOLD=0.60

# Maps (optional)
GOOGLE_MAPS_API_KEY=
